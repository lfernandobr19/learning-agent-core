# Copie para .env e ajuste os valores
# cp .env.example .env

# Dados locais (SQLite + Chroma)
LEARNING_DB=C:\Users\lfern\RAVENNA\learning-agent\learning-agent\data

# Supabase sync (opcional — false = local-only, SQLite + Chroma no PC)
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_KEY=sua-chave-anon-ou-service-role
CLOUD_SYNC_ENABLED=false

# Backup para OneDrive / Google Drive (cliente sincroniza a pasta)
# LOCAL_BACKUP_DIR=C:\Users\seu-user\Google Drive\Ravenna\learning-agent-backup
# LOCAL_BACKUP_KEEP=21

AUTO_SYNC=false
AUTO_SYNC_DEBOUNCE_SECONDS=15
AUTO_PROOFS=true

# API REST + dashboard
API_HOST=127.0.0.1
API_PORT=8000
MCP_HTTP_PORT=8001

# Autonomia dos agentes — 24/7 (desligue no modo treino PC + Vast)
# Loop de aprendizado em background (opcional). Autonomia conversacional na IDE funciona com false.
AUTO_AGENT_AUTONOMY=false
AUTONOMY_INTERVAL_SECONDS=600

# --- LLM: ordem de uso no chat ---
# 1) CHAT_* (Ollama local por padrão)
# 2) Se falhar → TEACHER_* (API na nuvem)

# Chat conversacional (Ollama local — recomendado)
CHAT_MODEL=phi3:mini
CHAT_MODEL_FAST=qwen2.5:0.5b
CHAT_API_BASE=http://localhost:11434/v1
CHAT_API_KEY=ollama
CHAT_TEMPERATURE=0.7
CHAT_HISTORY_LIMIT=10

# Embeddings do RAG (ChromaDB)
# default = EF nativa (onnxruntime) — recomendado no Windows.
# sentence-transformers = usa torch; NÃO misture com onnx no mesmo processo
# (duplica OpenMP e causa crash 0xC0000005 no Windows).
RAG_EMBEDDINGS=default

# Student local (Knowledge Distillation)
STUDENT_API_BASE=http://localhost:11434/v1
STUDENT_API_KEY=ollama
STUDENT_MODEL=qwen2.5:7b
RAVEN_BASE_MODEL=qwen2.5:14b
# Inferência local: 7b em 16GB RAM; 14b quando tiver 32GB+ ou GPU ≥8GB
RAVEN_RUNTIME_BASE=qwen2.5:7b
CHAT_TIMEOUT_SECONDS=300
RAVEN_MIN_DISTILL_PAIRS=80
RAVEN_MIN_CURSOR_PAIRS=30

# Teacher / fallback (quando Ollama não responde)
# Opção A — Groq (tier grátis): https://console.groq.com
TEACHER_API_BASE=https://api.groq.com/openai/v1
TEACHER_API_KEY=gsk_sua-chave-groq
TEACHER_MODEL=llama-3.3-70b-versatile

# Opção A2 — DeepSeek V4: https://platform.deepseek.com/api_keys
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_MODEL_FAST=deepseek-v4-flash
# Para usar DeepSeek como teacher, troque TEACHER_* por:
# TEACHER_API_BASE=https://api.deepseek.com/v1
# TEACHER_API_KEY=<sua DEEPSEEK_API_KEY>
# TEACHER_MODEL=deepseek-v4-pro

# Opção B — OpenAI
# TEACHER_API_BASE=https://api.openai.com/v1
# TEACHER_API_KEY=sk-sua-chave-openai
# TEACHER_MODEL=gpt-4o-mini

# Manutenção — DeepSeek V4 Pro (quando plano Cursor esgotado, ou terciário se Groq falhar)
# Chave: https://platform.deepseek.com — NUNCA commit; só .env / env do container
# MAINTENANCE_MODE=true → Ravenna usa DeepSeek como cloud (em vez de Groq)
MAINTENANCE_MODE=false
MAINTENANCE_API_BASE=https://api.deepseek.com/v1
MAINTENANCE_API_KEY=
# Alias opcional: DEEPSEEK_API_KEY=
MAINTENANCE_MODEL=deepseek-v4-pro

# EDITOR_TOKENS é JSON: {"<token>": {"user_id": "luis", "name": "Luis"}, ...}
# Um token por pessoa. Se vazio, o gateway /v1 fica aberto (protegido por LAN/Tailscale).
EDITOR_PROJECT=remote_app
EDITOR_LOCKED_ENGINE=deepseek_pro
EDITOR_TOKENS={}

# Usado pela tool MCP send_to_ravenna para gravar no SERVIDOR (de qualquer máquina).
# Preencha quando o Cursor rodar fora da máquina Ravenna (ex.: PC Windows via Tailscale):
# REMOTE_GATEWAY_URL_REMOVED=https://<RAVENNA_TAILSCALE_IP>:8000
# REMOTE_TOKEN_REMOVED=<seu-token-de-editor>

# Paridade cognitiva — mapeie modelos do SEU plano Cursor (mesma família via API)
# A API Ravenna não acessa modelos do Cursor diretamente; use equivalentes aqui.
MODEL_PARITY_TARGET_TIER=balanced
MODEL_PARITY_REFERENCE_FAST=phi3:mini
MODEL_PARITY_REFERENCE_BALANCED=llama-3.3-70b-versatile
MODEL_PARITY_REFERENCE_REASONING=llama-3.3-70b-versatile
MODEL_PARITY_MIN_SCORE=75
MODEL_PARITY_STRICT_MIN_SCORE=80
L6_REFINEMENT_EVERY_N_CYCLES=6

# Opção C — Claude via OpenRouter (pago; sem API Claude grátis direta)
# TEACHER_API_BASE=https://openrouter.ai/api/v1
# TEACHER_API_KEY=sk-or-sua-chave
# TEACHER_MODEL=anthropic/claude-3.5-haiku

DISTILL_TEMPERATURE=0.7
DISTILL_SOFT_TEMPERATURE=2.0
AUTO_DISTILL=true

AUTO_ACTIVE_LEARN=true
ACTIVE_LEARN_MAX_PER_RUN=3
STUDENT_FINETUNE_MODEL=raven
# Após criar o modelo: CHAT_MODEL=raven (cérebro local, sem API em runtime)

GITHUB_TOKEN=

TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
# Alertas automaticos (Prove/Ship/Train) — usa primeiro ALLOWED_USER_ID se CHAT_ID vazio
TELEGRAM_ALERT_ENABLED=true
TELEGRAM_ALERT_CHAT_ID=

# --- Modo treino: PC + Vast.ai (sessão) ---
# Crédito (atualize manualmente em console.vast.ai; alerta no ensure-finance-stack.ps1)
# VAST_CREDIT_USD=48.11
# VAST_CREDIT_ALERT_USD=20
# VAST_HOURLY_USD=0.188
# VAST_CREDIT_UPDATED=2026-06-11
# Com túnel SSH ativo (scripts\vast-session.ps1), aponte para Ollama remoto:
# CHAT_API_BASE=http://127.0.0.1:11435/v1
# CHAT_MODEL=qwen2.5:32b
# STUDENT_API_BASE=http://127.0.0.1:11435/v1
# Sem Vast: CHAT_API_BASE=http://localhost:11434/v1
# Agent na IDE: sempre Vast/local (qwen 32b) — histórico maior, sem limite Groq 413
# IDE_AGENT_USE_LOCAL=true
# AGENT_IDE_HISTORY_LIMIT=40
# AGENT_HISTORY_CONTENT_LIMIT=2000
# LLM_PAYLOAD_MAX_CHARS=250000
# Scripts: scripts\vast-remote-bootstrap.sh (na Vast) | vast-session.ps1 | vast-test.ps1

# --- Finance-lead autonomia (paper → live gradual) ---
# FINANCE_DECISION_MODE=assisted | autonomous_paper | off
# FINANCE_KILL_SWITCH=false
# FINANCE_MAX_POSITION_PCT=15
# FINANCE_MAX_CLASS_PCT=30
# FINANCE_MAX_DAILY_TRADES=3
# FINANCE_MAX_PORTFOLIO_DRAWDOWN_PCT=15
# FINANCE_MIN_CASH_PCT=10
# FINANCE_QUOTE_MAX_DIVERGENCE_PCT=3
# FINANCE_QUOTE_MAX_AGE_HOURS=24
# FINANCE_PAPER_BUDGET_BRL=5000
# FINANCE_GRADUATION_MIN_DAYS=90
# FINANCE_GRADUATION_MIN_TRADES=20

# Ravenna IDE — pasta pai para descobrir repositórios git irmãos (ex.: C:\Users\...\RAVENNA)
# RAVENNA_WORKSPACE_PARENT=C:\Users\lfern\RAVENNA
# RAVENNA_WORKSPACE_ROOT=C:\Users\lfern\RAVENNA\learning-agent\learning-agent

# --- Servidor remoto (SSH) — multi-servidor ---
# Preferência: IDE → Workspaces → Adicionar → Servidor remoto (salva em data/remote-servers.json).
# Alternativa: variáveis abaixo no .env (primeiro perfil / legado remoteapp_* ainda aceito).
# REMOTE_SSH_ALIAS=my-server
# REMOTE_SSH_HOST=203.0.113.10
# REMOTE_SSH_USER=ubuntu
# REMOTE_SSH_PORT=22
# REMOTE_SSH_IDENTITY=C:\Users\lfern\.ssh\key.pem
# REMOTE_SSH_PATH=/var/www/app
# REMOTE_WORKSPACE_LABEL=Meu app
# REMOTE_SSH_TERMINAL=true
# Scripts: scripts\remote-connect.ps1 -ProfileId <id> -TestOnly | -Connect | -Push

# --- OpenSubtitles (legendas no plano de mídia) ---
# Crie em https://www.opensubtitles.com/ → API consumers
# OPENSUBTITLES_API_KEY=
# OPENSUBTITLES_USERNAME=
# OPENSUBTITLES_PASSWORD=
# --- Open Finance (proxy Belvo — Financeiro PWA) ---
# BELVO_SECRET_ID=
# BELVO_SECRET_PASSWORD=
# BELVO_ENV=sandbox
